	column FY_num = VALUE([FY])
		lineageTag: 19957702-034a-48fa-8c44-5283cb02ec9e
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	partition Calendar = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR( DATE( 2016,4,1), DATE(2032,3,31)),
				    "Month", FORMAT([Date], "MM"),
				    "Month Number", MONTH( [Date]),
				    "Year", FORMAT([Date], "YYYY"),
				    "Quarter", "Q" & QUARTER([Date]),
				    "FY",
				    FORMAT(IF(MONTH([Date])<=3,value(FORMAT([Date],"YYYY"))-1,VALUE(FORMAT([Date],"YYYY"))),"General Number"),
				    "Month Number2",IF(MONTH([Date])<=3,month([Date])+9,MONTH([Date])-3)
				)

	annotation PBI_Id = efa196f5cf5741df9557602157f15a91

