			    SUM('riskEva'[申請予算])*1000,
			    TREATAS(VALUES('Dim_専門区分'[専門区分]),'riskEva'[管理区分]),
			    TREATAS(VALUES('keyword_list'[Index]),'riskEva'[Index])
			)
			RETURN
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE('単位'[単位])="億円",_x/100000000,
			    SELECTEDVALUE('単位'[単位])="百万円",_x/1000000,
			    SELECTEDVALUE('単位'[単位])="千円",_x/1000,
			    SELECTEDVALUE('単位'[単位])="円",_x,    
			    _x
			)
			```
		formatString: #,0
		displayFolder: riskEva
		lineageTag: 9b74a595-3799-4d84-8d6a-bec927415cf9

