	measure cost_plantia_工賃 = SUM('hozen_cycle'[工賃])
		formatString: #,0
		lineageTag: 9bcb591e-c78f-4ee1-9d60-87ea969983a1

	measure cost_購買 = ```
			
			VAR
			_x = CALCULATE(
			    SUM('購買明細'[実績明細金額]),
			    '購買明細'[区分]="修繕費",
			    '購買明細'[事業領域コード]="92",
			    TREATAS(VALUES('Dim_専門区分'[専門区分]),'購買明細'[専門区分])
			)
			RETURN
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE('単位'[単位])="億円",_x/100000000,
			    SELECTEDVALUE('単位'[単位])="百万円",_x/1000000,
			    SELECTEDVALUE('単位'[単位])="千円",_x/1000,
			    SELECTEDVALUE('単位'[単位])="円",_x,    
			    _x
			)
			```
		formatString: #,0
		lineageTag: 19cbcbb9-aec0-4c85-9835-17d0a6d460e3

	measure cost_plantia_材料 = SUM('hozen_cycle'[材料費])
		lineageTag: 5e09817b-4532-468c-ae6a-f09b6f6fb419

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure cost_plantia_total = ```
			
			VAR
			_kouchin = SUM('hozen_cycle'[工賃])
			VAR
			_zairyou = SUM('hozen_cycle'[材料費])
			VAR
			_x = _kouchin + _zairyou
			RETURN
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE('単位'[単位])="億円",_x/100000000,
			    SELECTEDVALUE('単位'[単位])="百万円",_x/1000000,
			    SELECTEDVALUE('単位'[単位])="千円",_x/1000,
			    SELECTEDVALUE('単位'[単位])="円",_x,    
			    _x
			)
			```
		formatString: #,0
		lineageTag: 04f45aa5-ab27-40b0-b997-0b13442fd334

	measure rank_by_family =
			
			VAR
			_cost_rank = RANKX(ALLSELECTED('plantia_list'[機器ファミリ]),CALCULATE([cost_plantia_total]),,,Dense)
			VAR
			_cost_best10 =
			SWITCH(
			    TRUE(),
			    _cost_rank<=10, _cost_rank,
			    BLANK()
			)
			VAR
			_count_rank = RANKX(ALLSELECTED('plantia_list'[機器ファミリ]),CALCULATE([# row_count]),,,Dense)
			VAR
			_count_best10 =
			SWITCH(
			    TRUE(),
			    _count_rank<=10, _count_rank,
			    BLANK()
			)
			VAR
			_cost_per_count_rank = RANKX(ALLSELECTED('plantia_list'[機器ファミリ]),CALCULATE([cost_per_count]),,,Dense)
			VAR
			_count_per_count_best10 =
			SWITCH(
			    TRUE(),
			    _cost_per_count_rank<=10, _cost_per_count_rank,
			    BLANK()
			)
			RETURN
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE('件数or金額'[選択])="金額",_cost_best10,
			    SELECTEDVALUE('件数or金額'[選択])="件数",_count_best10,
			    SELECTEDVALUE('件数or金額'[選択])="金額/件数",_count_per_count_best10
			)
		formatString: 0
		displayFolder: plantia
		lineageTag: d376d151-1dd6-4aad-b367-7f945703bc86

	measure ribbon_size_family =
			
			VAR
			_temp = 1 + [rank_by_family] * 0.01
			RETURN
			SWITCH(
			    TRUE(),
			    _temp>1,_temp,
			    BLANK()
			)
		displayFolder: plantia
		lineageTag: 6d16de9e-7293-49f4-85ed-a5b890043746

		annotation PBI_FormatHint = {"isGeneralNumber":true}

