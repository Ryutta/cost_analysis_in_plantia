	measure cost_予算 = ```
			
			VAR
			_x1 = CALCULATE(
			    SUM('予実管理'[計画予算金額]),
			    '予実管理'[区分]="修繕費",
			    '予実管理'[事業領域コード]="92",
			    TREATAS(VALUES('Calendar'[FY]),'予実管理'[予算年度]),
			    TREATAS(VALUES('プラント略号辞書'[原価センタ]),'予実管理'[原価センタ]),
			    TREATAS(VALUES('Dim_専門区分'[専門区分]),'予実管理'[専門区分])
			)
			VAR
			_x2 = 
			CALCULATE(
			    SUM('起業費・修繕費'[計画予算金額]),
			    TREATAS(VALUES('Calendar'[FY]),'起業費・修繕費'[予算年度]),
			    TREATAS(VALUES('プラント略号辞書'[原価センタ]),'起業費・修繕費'[原価センタ]),
			    TREATAS(VALUES('Dim_専門区分'[専門区分]),'起業費・修繕費'[専門区分])
			)
			VAR
			_x = _x1 + _x2
			
			RETURN
			SWITCH(
			    TRUE(),
			    SELECTEDVALUE('単位'[単位])="億円",_x/100000000,
			    SELECTEDVALUE('単位'[単位])="百万円",_x/1000000,
			    SELECTEDVALUE('単位'[単位])="千円",_x/1000,
			    SELECTEDVALUE('単位'[単位])="円",_x,    
			    _x
			)
			```
		lineageTag: c079fa8b-35ef-4d01-b782-a184ce842474

		annotation PBI_FormatHint = {"isGeneralNumber":true}

