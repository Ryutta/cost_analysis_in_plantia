	column 品質評価
		dataType: double
		lineageTag: 81971710-a8d6-4172-bf26-876c68ab8e4d
		summarizeBy: sum
		sourceColumn: 品質評価

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column _影響度 =
			
			SWITCH(
			    TRUE(),
			    [判定ＳＥＱＣＤ]="QCD",IF([生産評価]<[品質評価],[生産評価],[品質評価]),
			    [判定ＳＥＱＣＤ]="SE",IF([保安評価]<[環境評価],[保安評価],[環境評価]),
			    [_min_inf]
			)
		formatString: 0
		lineageTag: 5ec9b077-3c2b-44c3-84e4-d8a9de55c813
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _min_inf =
			
			VAR
			_x1 = MIN([保安評価],[環境評価])
			VAR
			_x2 = min([生産評価],[品質評価])
			RETURN
			MIN(_x1,_x2)
		lineageTag: 3bc297c7-3f12-4642-aad7-3b04612644ec
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column '周 期'
