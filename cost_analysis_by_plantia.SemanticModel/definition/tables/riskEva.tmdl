	column 周期2 =
			
			SWITCH(
			    TRUE(),
			    CONTAINSSTRING([周 期],"年"),VALUE(SUBSTITUTE([周 期],"年","")),
			    // CONTAINSSTRING([周 期],"月"),VALUE(SUBSTITUTE([周 期],"ヶ月",""))/12,
