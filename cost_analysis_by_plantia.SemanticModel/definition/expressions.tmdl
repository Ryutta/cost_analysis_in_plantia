expression keyword_list =
		let
		    Source = riskEva,
		    #"Filtered Rows" = Table.SelectRows(Source, each ([年度] <> "2024")),
		    #"Removed Other Columns" = Table.SelectColumns(#"Filtered Rows",{"保全名称", "Index"}),
		    ExtractWordsEndpoint = "http://nlpdev.intra.sharedom.net:5002",
		    ExtractWordsContents = (text) =>
		        let
		            headers = [#"Content-Type" = "application/json"],
		            postData = Json.FromValue([t = text]),
		            contents = Web.Contents(ExtractWordsEndpoint, [RelativePath = "keywords",  Headers = headers, Content = postData])
		        in
		            contents,
		    ExtractWords = (text) =>
		        let
		            words = if text <> null then Text.Combine(Json.Document(ExtractWordsContents(text))[results], " ") else ""
		        in
		            words,
		    #"kw_list" = Table.AddColumn(#"Removed Other Columns","kw", each ExtractWords([#"保全名称"])),
		    #"Split Column by Delimiter" = Table.ExpandListColumn(Table.TransformColumns(kw_list, {{"kw", Splitter.SplitTextByDelimiter(" ", QuoteStyle.Csv), let itemType = (type nullable text) meta [Serialized.Text = true] in type {itemType}}}), "kw"),
		    #"Changed Type" = Table.TransformColumnTypes(#"Split Column by Delimiter",{{"kw", type text}}),
		    #"Removed Other Columns1" = Table.SelectColumns(#"Changed Type",{"Index", "kw"}),
		    #"Removed Errors" = Table.RemoveRowsWithErrors(#"Removed Other Columns1", {"kw"})
		in
		    #"Removed Errors"
		// let
		//     Source = hozen_cycle,
		//     #"Removed Other Columns" = Table.SelectColumns(Source,{"保全名称"})
		// in
		//     #"Removed Other Columns"
